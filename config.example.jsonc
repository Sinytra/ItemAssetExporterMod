{
  // Output base path, relative to the "run" directory
  "output_path": "wiki_exporter",
  // Enabled exporter modules
  "enabled": [
    "metadata",
    "render"
  ],
  // In-game ID namespaces to export from. Can be overriden in per-module configs
  "namespaces": [
    "minecraft"
  ],
  // Per-module config
  "modules": {
    "render": {
      // Export file resolution in px
      "resolution": 128,
      // Enable static texture exports
      "png": true
    },
    "metadata": {}
  }
}